# Copy to apps/web/.env.local when running `pnpm run dev` natively
# (`make web-dev` does this for you). Not needed for `make dev` — the
# Compose stack sets these on the web container directly.
#
# Server-side only. Never prefix anything here with NEXT_PUBLIC_: these
# back the app/api/* route handlers, which proxy to the Go API so the
# auth token never reaches browser JS (docs/adr/ADR-015-single-user-auth.md).

# Where the Go API is listening. Must match SCOUT_API_PORT in the repo
# root's .env (8081 in .env.example) — `make dev` publishes the api
# container on that host port.
SCOUT_API_URL=http://127.0.0.1:8081

# Must equal SCOUT_AUTH_TOKEN in the repo root's .env — this is the value
# the login page checks a typed token against, and the value the proxy
# routes send upstream.
SCOUT_AUTH_TOKEN=local-development-token-not-a-secret-000

# "local" keeps the session cookie non-Secure so plain-HTTP localhost can
# store it. Production sets "production" (infra/compose/production.yml).
SCOUT_ENV=local
