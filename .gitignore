# Build output
/bin/
/dist/
*.exe

# Go
*.test
*.out
vendor/

# Node
node_modules/
.next/
.turbo/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Secrets — never commit. Encrypted SOPS files (*.enc.yaml) are the exception.
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
google-services.json

# Local state
/infra/compose/.data/
*.log

# Eval run history — regenerated by `make evals`, compared by `make
# evals-report`. Local/CI-run artifacts, not source.
/evals/results/

# macOS
.DS_Store

# Compiled binaries dropped at the repo root by `go build ./cmd/...`
/discover
/collector
/api
/notifier

# A real personal resume used locally to exercise resume-parsing edge
# cases (hyphenation, unicode). AGENTS.md rule 9's corollary: never commit
# the resume, this repo is public. handler_test.go skips cleanly without
# it — see fixtures/sample_resume.pdf for the synthetic fixture CI uses.
apps/api/internal/resume/fixtures/real_resume_sample.pdf

# Real resume text for `make seed-resume` (same rule as above). See
# infra/seed/resume.sql.example for the template.
infra/seed/resume.sql
