# Copy to .env for local development. Never commit .env.
#
# `make dev` copies this file for you if .env is missing.
#
# Production secrets live in SOPS-encrypted files, not here.
# See docs/13-security-privacy.md.

# --- Local ports ---
# Non-default on purpose, so Scout coexists with other stacks on the same
# machine. A port collision is nasty to diagnose: psql connects successfully,
# just to the wrong database.
SCOUT_PG_PORT=5433
SCOUT_REDIS_PORT=6380
SCOUT_API_PORT=8081
SCOUT_WEB_PORT=3000

# --- Mobile connectivity (ADR-012 vs ADR-018's unreconciled gap — see
# apps/mobile/README.md) ---
# Both empty is ADR-018's own default: api/web bind 127.0.0.1 only,
# unreachable from apps/mobile on a real phone. To make them reachable:
#   1. sudo brew services start tailscale   (needs your password — brew
#      install tailscale first; this repo's setup only got as far as
#      installing the binary, starting the daemon needs root)
#   2. sudo tailscale up                    (opens a browser to log in)
#   3. tailscale ip -4                      (prints this laptop's tailnet
#      IP, stable across reboots once the same account re-authenticates)
#   4. Paste that IP below, `docker compose down && ... up -d` to rebind
#   5. Install Tailscale on the phone too (Play Store), log into the SAME
#      tailnet account — a phone not on the tailnet can't reach this IP
#      no matter what it's set to.
#   6. Set SCOUT_MOBILE_SERVER_URL (apps/mobile's own .env, not this one)
#      to http://<that IP or the tailnet's MagicDNS name>:${SCOUT_WEB_PORT}
#      and `npx cap sync android` before the next build.
# SCOUT_HOST_BIND_ADDR=

# --- Database ---
SCOUT_DATABASE_URL=postgres://scout:scout_local_dev_only@localhost:5433/scout?sslmode=disable

# --- Redis ---
# Holds nothing durable — see AGENTS.md rule 8.
SCOUT_REDIS_URL=redis://localhost:6380/0

# --- API ---
SCOUT_API_ADDR=:8081
SCOUT_ENV=local

# The single credential (ADR-015). The API refuses to start without it.
#
# This local value is a placeholder guarding a database of fixtures on a laptop.
# Generate the real one at setup, put it in the SOPS-encrypted environment file,
# and never anywhere else:
#
#   openssl rand -base64 36
#
# Minimum 32 characters. Typed once per device, ever; rotation is changing this
# variable and restarting.
SCOUT_AUTH_TOKEN=local-development-token-not-a-secret-000

# Fixtures-only by default — a debugging session must not be able to hammer
# a real company's careers page by accident. Set to false for ADR-018's
# laptop-only "live" run (real fetching against due sources, no separate
# compose file needed — infra/compose/local.yml's collector service reads
# this var).
SCOUT_FIXTURES_ONLY=true

# --- Google Calendar integration (apps/api/internal/googlecalendar) ---
# All three empty is a valid, fully supported state — the integration
# just doesn't appear as connectable anywhere in the UI. To enable it:
#
#   1. console.cloud.google.com → new (or existing) project
#   2. APIs & Services → Library → enable "Google Calendar API"
#   3. APIs & Services → Credentials → Create Credentials →
#      OAuth client ID → Application type: Web application
#   4. Authorized redirect URIs — add BOTH, you'll want both eventually:
#        http://localhost:3000/api/integrations/google/callback
#        https://scout.<your-tailnet>.ts.net/api/integrations/google/callback
#   5. Paste the resulting Client ID and Client secret below.
#
# SCOUT_GOOGLE_REDIRECT_URL must exactly match whichever URI you're
# actually running behind, byte for byte — Google rejects a mismatch.
SCOUT_GOOGLE_CLIENT_ID=
SCOUT_GOOGLE_CLIENT_SECRET=
SCOUT_GOOGLE_REDIRECT_URL=http://localhost:3000/api/integrations/google/callback

# --- Seed (infra/seed/seed.sql via `make seed`) ---
# The single user's email (ADR-015). Personal, so it lives here rather than
# in the committed seed SQL. Falls back to a placeholder if unset so a
# from-scratch `make dev` never fails on first boot.
SCOUT_USER_EMAIL=dev@scout.local

# =============================================================================
# Production only. None of these are used by the local stack; they are listed
# here because the host's environment file is this file's shape, and a variable
# that exists only in someone's memory is one that goes missing during a host
# migration (docs/15 section 6).
# =============================================================================

# --- Postgres (production) ---
# There is no default password. infra/compose/production.yml refuses to start
# without this set, because a default database password on a host is a default
# database password whatever the network in front of it.
# SCOUT_PG_USER=scout
# SCOUT_PG_PASSWORD=
# SCOUT_PG_DATABASE=scout

# --- Dead-man's switch (docs/16 section 2.2) ---
# The collector pings this every 5 minutes; healthchecks.io alerts Telegram if
# the pings stop for 15. The URL contains the check's UUID, which makes it a
# bearer credential — it is never logged.
# SCOUT_HEALTHCHECK_URL=https://hc-ping.com/<uuid>
# SCOUT_HEALTHCHECK_INTERVAL=5m

# A second, separate check for the backup job. Silent backup failure is the real
# risk in ADR-017, so it gets its own switch rather than sharing the collector's.
# SCOUT_BACKUP_HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# --- Telegram (operator alerts) ---
# The only alert channel at ₹0 that reaches a phone without a domain or a paid
# tier. Used by the deploy health gate and the backup job for direct alerts;
# healthchecks.io sends its own via its Telegram integration.
# SCOUT_TELEGRAM_BOT_TOKEN=
# SCOUT_TELEGRAM_CHAT_ID=

# --- Telegram (notifier channel, docs/11 section 11) ---
# A separate bot from the operator-alerts one above — this is the channel
# job notifications actually go out on, distinct from "the collector died"
# alerts. Same BotFather flow, a second bot. Run
# `notifier -setup` once after setting the token: it long-polls for the
# first message you send the bot and stores that chat's id.
# SCOUT_NOTIFIER_TELEGRAM_BOT_TOKEN=

# --- Native push / FCM (ADR-012, P4) ---
# Both empty is a valid disabled state — the notifier degrades to
# Telegram-only, same as every other optional integration in this file.
# Firebase console: create a project, then Project Settings > Service
# Accounts > "Generate new private key" for the JSON below. Minify it to
# one line (e.g. `jq -c . key.json`) before pasting — this file, like
# every other secret here, doesn't support multi-line values.
# SCOUT_FCM_PROJECT_ID=
# SCOUT_FCM_SERVICE_ACCOUNT_JSON=

# --- Politeness gate (docs/06 section 4, docs/14 section 1) ---
# The operator's real email. Published in the User-Agent's From header on
# every outbound request to a source (SCOUT-LEGAL-003) — "we identify
# honestly and provide contact information... a site operator who can reach
# you sends an email instead of a block." Not a secret in the sense of
# something an attacker could misuse, but it is the operator's personal
# address, so it comes from this file rather than being pinned in
# infra/compose/production.yml the way the contact URL is.
# SCOUT_COLLECTOR_OPERATOR_EMAIL=

# --- Backup (ADR-017) ---
# The age PUBLIC key. The private half lives on offline media and must never be
# on the host: a host that can decrypt its own backups turns a host compromise
# into a compromise of the entire application history.
# SCOUT_AGE_RECIPIENT=age1...
# SCOUT_BACKUP_DIR=/var/lib/scout/backups
# SCOUT_BACKUP_RETAIN_DAYS=14
# Two destinations, both free and already owned. Either can be unreachable.
# SCOUT_BACKUP_MAC_DEST=macbook:scout-backups
# SCOUT_BACKUP_RCLONE_DEST=scout-drive:backups

# --- Restore drill (run on the MacBook) ---
# SCOUT_LOCAL_BACKUP_DIR=~/scout-backups
# SCOUT_AGE_KEY_FILE=~/keys/scout-backup.age

# --- Email-alert ingestion (docs/05-source-catalog.md, ADR-014) ---
# IMAP poll, not a webhook — Scout has no public ingress. Point this at a
# mailbox subscribed to LinkedIn/Indeed/Glassdoor/Handshake job alerts; all
# four fields must be set together or the poller stays disabled. An app
# password is strongly recommended over the account's real password.
# SCOUT_EMAIL_IMAP_HOST=imap.gmail.com
# SCOUT_EMAIL_IMAP_PORT=993
# SCOUT_EMAIL_IMAP_USER=
# SCOUT_EMAIL_IMAP_PASSWORD=
# SCOUT_EMAIL_IMAP_MAILBOX=INBOX

# --- LLM cascade (ADR-016, infra/config/llm_providers.yaml) ---
# apps/brain/scout_brain/config.py skips any provider whose key is unset,
# so having none of these configured is a valid state: the cascade falls
# straight to the local Ollama tier, exactly as it did before hosted
# providers existed. Set at least one to close the measured quality gap
# evals/README.md documents at the local-only tier. All three are free —
# see infra/config/llm_providers.yaml's own comments for exactly which
# model and rate limit each maps to, corrected 2026-08-20 after the
# originally configured models turned out to already be dead (free-tier
# model lineups churn — re-verify before assuming any of these still
# resolve).
# SCOUT_BRAIN_GEMINI_API_KEY=
# SCOUT_BRAIN_GROQ_API_KEY=
# SCOUT_BRAIN_OPENROUTER_API_KEY=
# SCOUT_BRAIN_NVIDIA_API_KEY=

# --- Observability (docs/16-observability.md, ADR-011) ---
# infra/compose/observability.yml is a separate compose file, merged in
# via `-f`: `docker compose -f infra/compose/local.yml -f
# infra/compose/observability.yml up`. None of these are required for the
# core stack to run without it.

# The dedicated /metrics listener apps/collector and apps/notifier open
# (apps/api serves its own on the existing API port instead). Only
# override if :9090 collides with something else on the host.
# SCOUT_METRICS_ADDR=:9090

# OTel traces (apps/api only today — see packages/tracing's own comment
# for what's built vs. deferred). Unset disables tracing entirely, the
# same "absence is a valid, quiet state" posture as every other optional
# integration in this project.
# SCOUT_OTEL_COLLECTOR_ENDPOINT=otel-collector:4318

# Grafana's one admin account (ADR-015's single-user posture applied to
# this stack too) — required, not defaulted, the same reasoning as
# SCOUT_PG_PASSWORD in production.
# SCOUT_GRAFANA_ADMIN_PASSWORD=

# Which real Docker network infra/compose/observability.yml's containers
# join to resolve api/collector/brain/notifier by name — must match
# whichever base compose file you're merging it with. local.yml already
# names its own network "scout-local" (this variable's default), so local
# development needs nothing set. Merging with production.yml needs
# SCOUT_COMPOSE_NETWORK=scout, matching that file's own network name.
# SCOUT_COMPOSE_NETWORK=scout-local

# --- Hosted pipeline (ADR-019) ---
# No values here. These live as encrypted secrets, never in the repository:
#   GitHub (Settings > Secrets and variables > Actions), used by ingest.yml:
#     SCOUT_DATABASE_URL            Neon connection string (sslmode=require)
#     SCOUT_REDIS_URL               Upstash rediss:// URL
#     SCOUT_COLLECTOR_OPERATOR_EMAIL, SCOUT_NOTIFIER_TELEGRAM_BOT_TOKEN
#     optional: SCOUT_FCM_*, SCOUT_BRAIN_*_API_KEY
#     variable SCOUT_FIXTURES_ONLY=false to fetch live sources
#   Render (scout-api, render.yaml): SCOUT_DATABASE_URL, SCOUT_REDIS_URL,
#     SCOUT_AUTH_TOKEN, SCOUT_USER_EMAIL
#   Vercel (apps/web): SCOUT_API_URL (the Render URL), SCOUT_AUTH_TOKEN,
#     SCOUT_ENV=production
