# Copy to .env for local development. Never commit .env.
#
# `make dev` copies this file for you if .env is missing.
#
# Production secrets live in SOPS-encrypted files, not here.
# See docs/13-security-privacy.md.

# --- Local ports ---
# Non-default on purpose, so Scout coexists with other stacks on the same
# machine. A port collision is nasty to diagnose: psql connects successfully,
# just to the wrong database.
SCOUT_PG_PORT=5433
SCOUT_REDIS_PORT=6380
SCOUT_API_PORT=8081

# --- Database ---
SCOUT_DATABASE_URL=postgres://scout:scout_local_dev_only@localhost:5433/scout?sslmode=disable

# --- Redis ---
# Holds nothing durable — see AGENTS.md rule 8.
SCOUT_REDIS_URL=redis://localhost:6380/0

# --- API ---
SCOUT_API_ADDR=:8081
SCOUT_ENV=local

# The single credential (ADR-015). The API refuses to start without it.
#
# This local value is a placeholder guarding a database of fixtures on a laptop.
# Generate the real one at setup, put it in the SOPS-encrypted environment file,
# and never anywhere else:
#
#   openssl rand -base64 36
#
# Minimum 32 characters. Typed once per device, ever; rotation is changing this
# variable and restarting.
SCOUT_AUTH_TOKEN=local-development-token-not-a-secret-000

# Local development never fetches live sources. Leave this on.
SCOUT_FIXTURES_ONLY=true

# =============================================================================
# Production only. None of these are used by the local stack; they are listed
# here because the host's environment file is this file's shape, and a variable
# that exists only in someone's memory is one that goes missing during a host
# migration (docs/15 section 6).
# =============================================================================

# --- Postgres (production) ---
# There is no default password. infra/compose/production.yml refuses to start
# without this set, because a default database password on a host is a default
# database password whatever the network in front of it.
# SCOUT_PG_USER=scout
# SCOUT_PG_PASSWORD=
# SCOUT_PG_DATABASE=scout

# --- Dead-man's switch (docs/16 section 2.2) ---
# The collector pings this every 5 minutes; healthchecks.io alerts Telegram if
# the pings stop for 15. The URL contains the check's UUID, which makes it a
# bearer credential — it is never logged.
# SCOUT_HEALTHCHECK_URL=https://hc-ping.com/<uuid>
# SCOUT_HEALTHCHECK_INTERVAL=5m

# A second, separate check for the backup job. Silent backup failure is the real
# risk in ADR-017, so it gets its own switch rather than sharing the collector's.
# SCOUT_BACKUP_HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# --- Telegram ---
# The only alert channel at ₹0 that reaches a phone without a domain or a paid
# tier. Used by the deploy health gate and the backup job for direct alerts;
# healthchecks.io sends its own via its Telegram integration.
# SCOUT_TELEGRAM_BOT_TOKEN=
# SCOUT_TELEGRAM_CHAT_ID=

# --- Politeness gate (docs/06 section 4, docs/14 section 1) ---
# The operator's real email. Published in the User-Agent's From header on
# every outbound request to a source (SCOUT-LEGAL-003) — "we identify
# honestly and provide contact information... a site operator who can reach
# you sends an email instead of a block." Not a secret in the sense of
# something an attacker could misuse, but it is the operator's personal
# address, so it comes from this file rather than being pinned in
# infra/compose/production.yml the way the contact URL is.
# SCOUT_COLLECTOR_OPERATOR_EMAIL=

# --- Backup (ADR-017) ---
# The age PUBLIC key. The private half lives on offline media and must never be
# on the host: a host that can decrypt its own backups turns a host compromise
# into a compromise of the entire application history.
# SCOUT_AGE_RECIPIENT=age1...
# SCOUT_BACKUP_DIR=/var/lib/scout/backups
# SCOUT_BACKUP_RETAIN_DAYS=14
# Two destinations, both free and already owned. Either can be unreachable.
# SCOUT_BACKUP_MAC_DEST=macbook:scout-backups
# SCOUT_BACKUP_RCLONE_DEST=scout-drive:backups

# --- Restore drill (run on the MacBook) ---
# SCOUT_LOCAL_BACKUP_DIR=~/scout-backups
# SCOUT_AGE_KEY_FILE=~/keys/scout-backup.age
