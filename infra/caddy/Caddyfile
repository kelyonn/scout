# Caddy routes requests inside the Docker network. It does not terminate TLS and
# it does not listen on a host port.
#
# The ingress chain is:
#
#   phone / laptop
#     → tailnet (WireGuard)
#       → tailscaled ON THE HOST, `tailscale serve` (terminates TLS with a real
#         Let's Encrypt cert for scout.<tailnet>.ts.net, issued by `tailscale
#         cert` — no ACME challenge, no domain, no public DNS)
#         → this Caddy, at a fixed address on the Docker bridge network
#           → api / web
#
# The host can route to a bridge-network container address directly, which is
# what makes the middle hop work with no `ports:` entry anywhere in the stack.
# That is not a detail — it is the property docs/15 section 2 describes as "the
# absence of a public surface", and infra/scripts/health-gate.sh fails the deploy
# if any container acquires a published port.
#
# Because nothing but tailscaled can reach this listener, TLS here would be
# encrypting a hop that never leaves the host. See docs/15 section 2 and
# infra/compose/production.yml.
{
	# No automatic HTTPS: `tailscale serve` owns the certificate, and Caddy
	# trying to provision one would attempt an ACME challenge against a name
	# that has no public DNS record.
	auto_https off

	admin off

	log {
		format json
	}
}

:8080 {
	# Health of the proxy itself. Distinct from the API's /health so that "Caddy
	# is up" and "the API is up" are separable when something is wrong at 2am.
	handle /_caddy/health {
		respond "ok" 200
	}

	# The Go API's own real path prefix (apps/api/cmd/main.go's
	# protected ServeMux: GET /v1/jobs, /v1/resume, /v1/search, ...) — for
	# a direct caller that isn't the web app itself (a future mobile app,
	# curl, a script holding its own SCOUT_AUTH_TOKEN). This used to say
	# `/api/*` with the prefix stripped, which forwarded to paths like
	# `/jobs` that the API has never served at any point — dead since
	# whenever this file was written, and only found now while adding
	# `web` below. The web app's own /api/* (its BFF route handlers,
	# app/api/*/route.ts) is a completely different namespace and reaches
	# api:8080 itself, server-side, with its own copy of the token — see
	# apps/web/app/api/jobs/route.ts's own comment.
	handle /v1/* {
		reverse_proxy api:8080
	}

	# The API's own health check, reachable without a prefix so that the
	# deploy health gate and the API's container healthcheck probe the same path.
	handle /health {
		reverse_proxy api:8080
	}

	handle /auth/* {
		reverse_proxy api:8080
	}

	# infra/compose/observability.yml (P3) — not started by
	# production.yml alone, and this route 404s harmlessly (upstream
	# unreachable) when it isn't. Grafana itself has no published host
	# port, by the same "nothing publishes a host port" rule as every
	# other service in this stack (infra/compose/production.yml's own
	# comment) — this reverse proxy is the only way to reach it.
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# Everything else — /, /login, /opportunities, and the web app's own
	# /api/* BFF routes (app/api/*/route.ts, including /api/auth/login) —
	# goes to the Next.js app. This was a 404 placeholder ("dashboard not
	# built yet") from before apps/web existed; P3 shipped it and this
	# route was never updated to match, so production had no way to reach
	# it even once it was code-complete.
	handle {
		reverse_proxy web:3000
	}

	log {
		format json
	}
}
